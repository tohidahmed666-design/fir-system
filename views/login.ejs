<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FIR System - Login</title>
    <!-- Link manifest for PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#1e3c72">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #333;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo-left { height: 40px; }
        .logo-right { height: 60px; }

        .container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-box {
            width: 100%;
            max-width: 400px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(15px);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            border: 1px solid rgba(255,255,255,0.4);
            transition: transform 0.3s ease;
        }

        .login-box:hover {
            transform: translateY(-5px);
        }

        h2 {
            text-align: center;
            color: #1e3c72;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .form-group {
            margin-bottom: 20px;
        }

        select, input {
            width: 100%;
            padding: 14px;
            font-size: 16px;
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 8px;
            background: rgba(255,255,255,0.8);
            transition: all 0.3s ease;
        }

        select:focus, input:focus {
            outline: none;
            border-color: #2a5298;
            box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.2);
        }

        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            font-size: 16px;
            font-weight: 600;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(30, 60, 114, 0.4);
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(30, 60, 114, 0.6);
        }

        .error {
            color: #d32f2f;
            background: #ffebee;
            padding: 10px;
            border-radius: 6px;
            text-align: center;
            margin-bottom: 20px;
            font-size: 14px;
        }
        
        /* Background decorative elements */
        .bg-circle {
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            z-index: 0;
        }
        .circle1 { width: 300px; height: 300px; top: -50px; left: -100px; }
        .circle2 { width: 400px; height: 400px; bottom: -100px; right: -100px; }

    </style>
</head>

<body>
<div class="bg-circle circle1"></div>
<div class="bg-circle circle2"></div>

<!-- HEADER -->
<div class="header" style="z-index: 2;">
    <img src="/public/images/G-NTTF.png" class="logo-left" alt="" onerror="this.style.display='none'">
    <img src="/public/images/Police.png" class="logo-right" alt="" onerror="this.style.display='none'">
</div>

<!-- LOGIN BOX -->
<div class="container" style="z-index: 2;">
    <div class="login-box">
        <h2>Welcome Back</h2>

        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login">
            <div class="form-group">
                <select name="username" required>
                    <option value="">Select User</option>
                    <% if (typeof users !== "undefined" && users && users.length > 0) { %>
                        <% users.forEach(u => { %>
                            <option value="<%= u.username %>"><%= u.username %></option>
                        <% }) %>
                    <% } else { %>
                        <option value="DCRB DPO Gadag">DCRB DPO Gadag</option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <input type="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit">Login Securely</button>
        </form>
    </div>
</div>

<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js');
    });
  }
</script>
</body>
</html>